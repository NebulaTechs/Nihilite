{:paths ["src/main/clojure"
         ;; target/classes LAST, and it must stay last. HookAdvice and the two
         ;; generated exception classes are written there by AOT and nothing
         ;; else can provide them, which is why the contract namespaces fail to
         ;; load without it -- 13 of 23, on a static (catch
         ;; HookCancelledException) in dispatch.clj:149 and advice.clj:90 whose
         ;; constant-pool ref has to resolve at ns-load.
         ;;
         ;; :extra-paths PREPENDS, so putting it there instead would place it
         ;; AHEAD of src/main/clojure -- which is exactly the stale-.class
         ;; hazard reset-derived-dir! (build.clj:65-85) exists to prevent, and
         ;; which this ordering makes impossible for namespaced code: every
         ;; namespace has a .clj, so source always wins; only source-less
         ;; generated orphans are read from here.
         "target/classes"]

 :mvn/repos {"clojars" {:url "https://repo.clojars.org"}}

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/spec.alpha {:mvn/version "0.6.249"}
        org.clojure/core.specs.alpha {:mvn/version "0.5.81"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        net.bytebuddy/byte-buddy {:mvn/version "1.18.14"}
        net.bytebuddy/byte-buddy-agent {:mvn/version "1.18.14"}}

:aliases
  {;; :dev adds the test sources so an editor or REPL sees them. Together with
   ;; target/classes in :paths that is enough to LOAD the contract namespaces,
   ;; which it was not before: 13 of the 23 used to fail at ns-load on a
   ;; generated exception class that no classpath provided.
   ;;
   ;; It still does NOT make `clojure -M:dev -m ...` a way to RUN the suite.
   ;; Those classes are produced by AOT, so nothing resolves until
   ;; `clojure -T:build compile-clj` has run at least once, and re-running it is
   ;; what keeps them in step with the source. The supported entry point stays
   ;; the build:
   ;;   clojure -T:build compile-clj && clojure -T:build clojure-contract-test
   ;;
   ;; target/classes therefore belongs in :paths, and deliberately NOT in this
   ;; alias's :extra-paths: :extra-paths prepends, so adding it here would place
   ;; it ahead of the source roots and let a stale .class shadow the source it
   ;; was generated from -- the incident reset-derived-dir! records.
   :dev {:extra-paths ["src/test/clojure"]}

   :build {:deps {io.github.clojure/tools.build
                  {:git/tag "v0.10.10"
                   :git/sha "deedd62"}}
           :ns-default build}}}
